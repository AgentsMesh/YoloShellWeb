{
  "schema_version": 1,
  "id": "web.client",
  "name": "Yolo Web Client",
  "version": "0.2.10",
  "description": "Interactive terminals and managed agent chat for YoloShell",
  "platforms": [
    "linux",
    "macos"
  ],
  "startup": {
    "command": [
      "bun",
      "client/scripts/plugin.ts",
      "start"
    ]
  },
  "actions": [
    {
      "id": "status",
      "title": "Status",
      "command": [
        "bun",
        "client/scripts/plugin.ts",
        "status"
      ]
    },
    {
      "id": "stop",
      "title": "Stop",
      "command": [
        "bun",
        "client/scripts/plugin.ts",
        "stop"
      ]
    }
  ],
  "web": {
    "title": "Yolo Web Client"
  },
  "api": {
    "protocol_version": 18,
    "required_methods": [
      "hello",
      "list",
      "list_agents"
    ],
    "optional_methods": [],
    "features": []
  }
}
